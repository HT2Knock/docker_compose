# Copy to .env and fill in. .env holds secrets and is not committed.

# Public server URL, used for links. Not a secret.
NTFY_BASE_URL='https://ntfy.example.com'

# bcrypt hash from: python3 -c "import bcrypt;print(bcrypt.hashpw(b'PASSWORD', bcrypt.gensalt(10)).decode())"
# Format is user:hash:role
NTFY_AUTH_USERS='admin:REPLACE_WITH_BCRYPT_HASH:admin'

# Publishing token for scripts. Generate with:
#   echo "tk_$(openssl rand -hex 16)"
# Format is user:token[:label]
NTFY_AUTH_TOKENS='admin:tk_REPLACE_WITH_TOKEN:scripts'
